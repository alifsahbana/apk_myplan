    if (!container || !chevron) return;

    if (container.classList.contains('hidden')) {
      container.classList.remove('hidden');
      chevron.style.transform = 'rotate(0deg)';
    } else {
      container.classList.add('hidden');
      chevron.style.transform = 'rotate(-90deg)';
    }
  }

  function moveTaskToToday(btn) {
    const carryCard = btn.closest('section');
    if (!carryCard) return;

    btn.innerHTML = '<span class="material-symbols-outlined text-[16px] animate-spin">sync</span> Dipindahkan';
    btn.disabled = true;

    setTimeout(() => {
      carryCard.style.transition = 'all 0.4s ease';
      carryCard.style.opacity = '0';
      carryCard.style.transform = 'translateY(-10px)';
      setTimeout(() => carryCard.remove(), 400);
    }, 450);
  }

  function toggleTaskStatus(btn) {
    const icon = btn.querySelector('.material-symbols-outlined');
    const card = btn.closest('[data-task-id]');
    const title = card ? card.querySelector('.task-title') : null;

    if (!icon || !title) return;

    const isDone = icon.textContent.trim() === 'check_circle';
    if (!isDone) {
      icon.textContent = 'check_circle';
      icon.style.fontVariationSettings = "'FILL' 1";
      btn.classList.remove('text-brand-blue', 'bg-surface-soft');
      btn.classList.add('text-on-primary', 'bg-brand-blue');
      title.classList.add('line-through', 'text-text-muted');
      title.classList.remove('text-text-primary');

      // Micro haptic bump visual effect
      card.classList.add('scale-[0.99]', 'bg-surface-container-low/60');
    } else {
      icon.textContent = 'radio_button_unchecked';
      icon.style.fontVariationSettings = "'FILL' 0";
      btn.classList.add('text-brand-blue', 'bg-surface-soft');
      btn.classList.remove('text-on-primary', 'bg-brand-blue');
      title.classList.remove('line-through', 'text-text-muted');
      title.classList.add('text-text-primary');
      card.classList.remove('scale-[0.99]', 'bg-surface-container-low/60');
    }
  }
</script></main><nav class="fixed bottom-0 inset-x-0 z-50 pb-safe bg-surface/85 backdrop-blur-xl shadow-[0_-4px_20px_rgba(23,43,58,0.06)]" data-active-classes="text-primary-container font-semibold"><div class="h-16 px-space-xs flex items-center justify-around"><a aria-current="page" class="flex flex-col items-center justify-center min-w-[64px] h-12 gap-0.5 transition-all text-primary-container font-semibold" data-path="beranda" href="#"><span class="material-symbols-outlined text-[22px]">home</span><span class="font-caption text-caption">Beranda</span></a><a class="flex flex-col items-center justify-center min-w-[64px] h-12 gap-0.5 text-text-secondary transition-all hover:text-primary" data-path="kalender" href="#"><span class="material-symbols-outlined text-[22px]">calendar_today</span><span class="font-caption text-caption">Kalender</span></a><a class="flex flex-col items-center justify-center min-w-[64px] h-12 gap-0.5 text-text-secondary transition-all hover:text-primary" data-path="tugas" href="#"><span class="material-symbols-outlined text-[22px]">task_alt</span><span class="font-caption text-caption">Tugas</span></a><a class="flex flex-col items-center justify-center min-w-[64px] h-12 gap-0.5 text-text-secondary transition-all hover:text-primary" data-path="profil" href="#"><span class="material-symbols-outlined text-[22px]">insights</span><span class="font-caption text-caption">Profil</span></a></div></nav></body></html>