<script>
  function updateProgress() {
    const rows = document.querySelectorAll('.subtask-row');
    const total = rows.length;
    let completed = 0;
    rows.forEach(r => {
      if (r.getAttribute('data-completed') === 'true') {
        completed++;
      }
    });

    const percent = total > 0 ? Math.round((completed / total) * 100) : 0;
    const progressFill = document.getElementById('subtask-progress-fill');
    const counterText = document.getElementById('subtask-counter');

    if (progressFill) {
      progressFill.style.width = percent + '%';
    }
    if (counterText) {
      counterText.innerHTML = `${percent}% &bull; ${completed} dari ${total} selesai`;
    }
  }

  function toggleSubtask(btn) {
    const row = btn.closest('.subtask-row');
    const isCompleted = row.getAttribute('data-completed') === 'true';
    const textSpan = row.querySelector('.task-title');

    if (!isCompleted) {
      row.setAttribute('data-completed', 'true');
      btn.className = "w-7 h-7 rounded-full bg-success flex items-center justify-center text-on-primary shrink-0 active:scale-90 transition-transform shadow-[0_2px_6px_rgba(22,134,92,0.3)]";
      textSpan.classList.add('line-through', 'text-text-muted');
      textSpan.classList.remove('text-text-primary');
    } else {
      row.setAttribute('data-completed', 'false');
      btn.className = "w-7 h-7 rounded-full bg-surface-container flex items-center justify-center text-transparent shrink-0 active:scale-90 transition-transform hover:bg-surface-variant";
      textSpan.classList.remove('line-through', 'text-text-muted');
      textSpan.classList.add('text-text-primary');
    }

    updateProgress();
  }

  function promptNewStep() {
    const title = prompt("Masukkan deskripsi langkah baru:", "Periksa ulang catatan kaki");
    if (!title || !title.trim()) return;

    const list = document.getElementById('subtask-list');
    const newRow = document.createElement('div');
    newRow.className = "subtask-row flex items-center justify-between p-space-md rounded-xl bg-surface shadow-[0_2px_8px_-2px_rgba(23,43,58,0.04)] transition-all";
    newRow.setAttribute('data-id', Date.now());
    newRow.setAttribute('data-completed', 'false');

    newRow.innerHTML = `
      <div class="flex items-center gap-space-sm min-w-0 flex-1">
        <button type="button" onclick="toggleSubtask(this)" class="w-7 h-7 rounded-full bg-surface-container flex items-center justify-center text-transparent shrink-0 active:scale-90 transition-transform hover:bg-surface-variant">
          <span class="material-symbols-outlined text-[18px]">check</span>
        </button>
        <span class="task-title font-body-md text-body-md text-text-primary truncate flex-1">
          ${title.trim()}
        </span>
      </div>
      <div class="w-8 h-8 flex items-center justify-end text-outline-variant cursor-grab active:cursor-grabbing">
        <span class="material-symbols-outlined text-[20px]">drag_handle</span>
      </div>
    `;

    list.appendChild(newRow);
    updateProgress();
  }

  function markAllCompleted() {
    const rows = document.querySelectorAll('.subtask-row');
    rows.forEach(row => {
      row.setAttribute('data-completed', 'true');
      const btn = row.querySelector('button');
      const textSpan = row.querySelector('.task-title');
      if (btn) {
        btn.className = "w-7 h-7 rounded-full bg-success flex items-center justify-center text-on-primary shrink-0 active:scale-90 transition-transform shadow-[0_2px_6px_rgba(22,134,92,0.3)]";
      }
      if (textSpan) {
        textSpan.classList.add('line-through', 'text-text-muted');
        textSpan.classList.remove('text-text-primary');
      }
    });
    updateProgress();
  }
</script></main></body></html>